{
  "name": "dsh-opendesign-runway",
  "version": "1.0.4",
  "description": "在 DSH 输入框旁显示 OpenDesign 套餐额度和钱包余额：两个额度窗口、重置倒计时、速率推算、今日 token 与上次调用的模型和时间，另有一个设置页可查看调用记录并调整显示项目。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "adapters",
    "login",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "docs/*.png",
    "screenshots.json"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "opendesign",
    "quota",
    "usage"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node --test"
  }
}
